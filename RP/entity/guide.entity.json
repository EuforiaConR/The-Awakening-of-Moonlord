{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "awakening_moonlord:guide",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/entity/awakening_moonlord/npc/guide"
			},
			"geometry": {
				"default": "geometry.eu.awakening_moonlord.npc.guide"
			},
			"spawn_egg": {
				"base_color": "#DEA661",
				"overlay_color": "#B38528"
			},
			"scripts": {
				"pre_animation": [
					"variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
					"variable.tcos1 = -variable.tcos0;",
					"variable.internal_swim_pos = Math.mod(query.modified_distance_moved, 26.0);",
					"variable.z_bob = Math.cos(query.life_time * 103.13244) * 2.865 + 2.865;",
					"variable.x_bob = Math.sin(query.life_time * 76.776372) * 2.865;"
				],
				"animate": [
					{
						"controller_look_at_target": "!query.is_sleeping"
					},
					"controller_move",
					"controller_sleep",
					"controller_holding",
					"controller_charging",
					"controller_attack",
					"controller_sneaking",
					"controller_bob",
					"controller_damage_nearby_mobs",
					"controller_bow_and_arrow",
					"controller_swimming",
					"controller_use_item_progress"
				]
			},
			"animations": {
				//custom
				"idle": "animation.eu.awakening_tchulu.npc.idle",
				"walk": "animation.eu.awakening_tchulu.npc.walk",
				"sleeping": "animation.eu.awakening_tchulu.npc.sleep",
				//vanilla
				"look_at_target_default": "animation.humanoid.look_at_target.default",
				"look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
				"look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
				"move": "animation.humanoid.move",
				"riding.arms": "animation.humanoid.riding.arms",
				"riding.legs": "animation.humanoid.riding.legs",
				"holding": "animation.humanoid.holding",
				"charging": "animation.humanoid.charging",
				"attack.rotations": "animation.humanoid.attack.rotations",
				"sneaking": "animation.humanoid.sneaking",
				"bob": "animation.humanoid.bob",
				"damage_nearby_mobs": "animation.humanoid.damage_nearby_mobs",
				"bow_and_arrow": "animation.humanoid.bow_and_arrow",
				"swimming": "animation.humanoid.swimming",
				"use_item_progress": "animation.humanoid.use_item_progress",
				//controller
				//custom
				"controller_move": "controller.animation.eu.awakening_moonlord.guide",
				//vanilla
				"controller_look_at_target": "controller.animation.humanoid.look_at_target",
				//"controller_move": "controller.animation.humanoid.move",
				"controller_sleep": "controller.animation.sleeping_entity.sleep",
				"controller_holding": "controller.animation.humanoid.holding",
				"controller_brandish_spear": "controller.animation.humanoid.brandish_spear",
				"controller_charging": "controller.animation.humanoid.charging",
				"controller_attack": "controller.animation.humanoid.attack",
				"controller_sneaking": "controller.animation.humanoid.sneaking",
				"controller_bob": "controller.animation.humanoid.bob",
				"controller_damage_nearby_mobs": "controller.animation.humanoid.damage_nearby_mobs",
				"controller_bow_and_arrow": "controller.animation.humanoid.bow_and_arrow",
				"controller_swimming": "controller.animation.humanoid.swimming",
				"controller_use_item_progress": "controller.animation.humanoid.use_item_progress"
				//"riding": "controller.animation.humanoid.riding"
			},
			"render_controllers": [
				"controller.render.default"
			],
