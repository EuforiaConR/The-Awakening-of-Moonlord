{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.eu.awakening_tchulhu.eye_of_cthulhu.look_at_target": {
            "initial_state": "default",
            "states": {
                "default": {
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "dash": "query.property('eu:is_dashing')"
                        }
                    ],
                    "animations": [
                        "look_at_target"
                    ]
                },
                "dash": {
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "default": "!query.property('eu:is_dashing')"
                        }
                    ],
                    "animations": [
                        "look_at_dash"
                    ]
                }
            }
        },
        "controller.animation.eu.awakening_tchulhu.eye_of_cthulhu.general": {
            "initial_state": "default",
            "states": {
                "default": {
                    "blend_transition": 0.2,
                    "transitions": [],
                    "animations": [
                        {
                            "idle_phase_1": "query.property('eu:current_phase')==1"
                        },
                        {
                            "idle_phase_2": "query.property('eu:current_phase')==2"
                        }
                    ]
                }
            }
        }
    }
}