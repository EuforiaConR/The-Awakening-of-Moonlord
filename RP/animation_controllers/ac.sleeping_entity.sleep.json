{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.sleeping_entity.sleep": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "sleep": "q.is_sleeping"
                        }
                    ]
                },
                "sleep": {
                    "animations": [
                        "sleeping"
                    ],
                    "transitions": [
                        {
                            "default": "!q.is_sleeping"
                        }
                    ]
                }
            }
        }
    }
}