{
	"format_version": "1.10.0",
	"animations": {
		"animation.custom_shield.shield.wield_main_hand_first_person": {
			"loop": true,
			"bones": {
				"shield": {
					"rotation": ["variable.main_hand_first_person_rot_x", "variable.main_hand_first_person_rot_y", "variable.main_hand_first_person_rot_z"],
					"position": ["variable.main_hand_first_person_pos_x", "variable.main_hand_first_person_pos_y-10", "variable.main_hand_first_person_pos_z"]
				}
			}
		},
		"animation.custom_shield.shield.wield_off_hand_first_person": {
			"loop": true,
			"bones": {
				"shield": {
					"rotation": ["variable.off_hand_first_person_rot_x", "variable.off_hand_first_person_rot_y", "variable.off_hand_first_person_rot_z"],
					"position": [
						"variable.off_hand_first_person_pos_x",
						"variable.off_hand_first_person_pos_y-1",
						"(variable.is_using_bow ? variable.off_hand_first_person_with_bow_pos_z : variable.off_hand_first_person_pos_z)+5"
					]
				}
			}
		},
		"animation.custom_shield.shield.wield_main_hand_first_person_blocking": {
			"loop": "hold_on_last_frame",
			"bones": {
				"shield": {
					"rotation": ["variable.main_hand_first_person_rot_x", "variable.main_hand_first_person_rot_y - 12.0", "variable.main_hand_first_person_rot_z"],
					"position": ["variable.main_hand_first_person_pos_x", "variable.main_hand_first_person_pos_y-15", "variable.main_hand_first_person_pos_z"]
				}
			}
		},
		"animation.custom_shield.shield.wield_off_hand_first_person_blocking": {
			"loop": "hold_on_last_frame",
			"bones": {
				"shield": {
					"rotation": ["variable.off_hand_first_person_rot_x", "variable.off_hand_first_person_rot_y", "variable.off_hand_first_person_rot_z + 10.0"],
					"position": [
						"variable.off_hand_first_person_pos_x + 0.5",
						"variable.off_hand_first_person_pos_y+3.2",
						"(variable.is_using_bow ? variable.off_hand_first_person_with_bow_pos_z : variable.off_hand_first_person_pos_z)+8"
					]
				}
			}
		},
		"animation.custom_shield.shield.wield_third_person": {
			"loop": true,
			"bones": {
				"shield": {
					"rotation": [-90, 0, 90],
					"position": ["c.item_slot == 'main_hand' ? -1 : -0.5", 6, 9.3],
					"scale": ["c.item_slot == 'main_hand' ? 1.0 : -1.0", -1, "c.item_slot == 'main_hand' ? -1.0 : 1.0"]
				}
			}
		},
		"animation.custom_shield.player.shield_block_main_hand": {
			"loop": true,
			"bones": {
				"rightarm": {
					"rotation": ["!v.is_first_person ? -20.0 : 0", "!v.is_first_person ? -30.0 : 0", "!v.is_first_person ? -25.0 : 0"]
				},
				"rightitem": {
					"position": ["!v.is_first_person ? -1.0 : 0", "!v.is_first_person ? -3.0 : 0", 0],
					"rotation": [0, "!v.is_first_person ? -60.0 : 0", "!v.is_first_person ? -45.0 : 0"]
				}
			}
		},
		"animation.custom_shield.player.shield_block_off_hand": {
			"loop": true,
			"bones": {
				"leftarm": {
					"rotation": ["!v.is_first_person ? -20.0 : 0", "!v.is_first_person ? 20.0 : 0", "!v.is_first_person ? 20.0 : 0"]
				},
				"leftitem": {
					"position": ["!v.is_first_person ? 1.0 + query.item_is_charged * 1.5 : 0", "!v.is_first_person ? -3.0 + query.item_is_charged : 0", 0],
					"rotation": [
						"!v.is_first_person ? query.item_is_charged * 30.0 : 0",
						"!v.is_first_person ? 70.0 - query.item_is_charged * 60.0 : 0",
						"!v.is_first_person ? 65.0 - query.item_is_charged * 15.0 : 0"
					]
				}
			}
		}
	}
}