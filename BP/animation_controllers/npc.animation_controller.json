{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.eu.awakening_moonlord.npc.sleep": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"sleeping": "query.is_sleeping"
						}
					]
				},
				"sleeping": {
					"transitions": [
						{
							"wake_up": "!query.is_sleeping && (query.time_of_day >= 0.25 && query.time_of_day < 0.75)"
						}
					],
					"on_entry": [
						"/say when empiezas a dormir"
					]
				},
				"wake_up": {
					"transitions": [
						{
							"default": "(1.0)"
						}
					],
					"on_entry": [
						"/say hoy se durmio"
					]
				}
			}
		}
	}
}