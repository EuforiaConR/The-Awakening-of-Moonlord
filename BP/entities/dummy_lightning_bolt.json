{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "awakening_moonlord:dummy_lightning_bolt",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"despawn": {
				"minecraft:instant_despawn": {}
			}
		},
		"components": {
			"minecraft:type_family": {
				"family": [
					"inanimate",
					"dummy"
				]
			},
			"minecraft:movement": {
				"value": 0
			},
			"minecraft:behavior.melee_attack": {
				"priority": 4,
				"speed_multiplier": 1.25,
				"track_target": false,
				"reach_multiplier": 0.0 // this prevents creepers from ocasionally performing melee attacks while using this goal to chase
			},
			"minecraft:behavior.nearest_attackable_target": {
				"priority": 1,
				"must_see": true,
				"must_see_forget_duration": 3.0,
				"entity_types": [
					{
						"filters": {
							"test": "is_family",
							"subject": "other",
							"value": "player"
						},
						"max_dist": 16
					}
				]
			},
			"minecraft:target_nearby_sensor": {
				"inside_range": 2.5,
				"outside_range": 6.0,
				"must_see": true,
				"on_inside_range": {
					"event": "awakening_moonlord:start_lightning_bolt",
					"target": "self"
				}
			},
			"minecraft:timer": {
				"looping": true,
				"time": 30,
				"time_down_event": {
					"event": "awakening_moonlord:start_lightning_bolt"
				}
			},
			"minecraft:health": {
				"value": 1,
				"max": 1,
				"min": 1
			},
			"minecraft:collision_box": {
				"width": 0,
				"height": 0
			},
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": false
			},
			"minecraft:knockback_resistance": {
				"value": 100
			},
			"minecraft:on_death": {
				"event": "despawn"
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "all",
						"deals_damage": false
					}
				]
			}
		},
		"events": {
			"despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			},
			"awakening_moonlord:start_lightning_bolt": {
				"trigger": "despawn"
			}
		}
	}
}