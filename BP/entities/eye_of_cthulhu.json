{
  "format_version": "1.26.0",
  "minecraft:entity": {
    "description": {
      "identifier": "awaking_moonlord:eye_of_cthulhu",
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "awaking_moonlord:no_moving": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:flying_speed": {
          "value": 0.0
        }
      },
      "awaking_moonlord:moving_away_state": {
        "minecraft:timer": {
          "looping": true,
          "time": 1.5,
          "time_down_event": {
            "event": "awaking_moonlord:end_move_away"
          }
        }
      },
      "awaking_moonlord:dashing_state": {
        "minecraft:timer": {
          "looping": true,
          "time": 3,
          "time_down_event": {
            "event": "awaking_moonlord:end_dash"
          }
        }
      },
      "awaking_moonlord:search_nearby_player": {
        "minecraft:target_nearby_sensor": {
          "inside_range": 5.0,
          "outside_range": 10.0,
          "must_see": true,
          "on_inside_range": {
            "event": "awaking_moonlord:end_search_nearby_player",
            "target": "self"
          }
        }
      },
      "awaking_moonlord:hostile_state": {
        "minecraft:behavior.hurt_by_target": {
          "priority": 1
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 64
            }
          ]
        },
        "minecraft:attack": {
          "damage": 3
        },
        "minecraft:behavior.melee_box_attack": {
          "priority": 2,
          "attack_once": false,
          "track_target": false,
          "speed_multiplier": 1.4
        }
      }
    },
    "components": {
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(10,20) : 0"
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:behavior.random_hover": {
        "priority": 12,
        "xz_dist": 8,
        "y_dist": 8,
        "y_offset": 4, //-1
        "interval": 1,
        "hover_height": [
          5,
          10
        ]
      },
      "minecraft:leashable": {},
      "minecraft:balloonable": {
        "mass": 0.5
      },
      "minecraft:behavior.float": {
        "priority": 19
      },
      "minecraft:type_family": {
        "family": [
          "awaking_moonlord",
          "terra_boss",
          "eye_of_cthulhu",
          "mob",
          "arthropod"
        ]
      },
      "minecraft:breathable": {
        "totalSupply": 0,
        "suffocateTime": -1
      },
      "minecraft:collision_box": {
        "width": 2.5,
        "height": 2.5
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:game_event_movement_tracking": {
        "emit_flap": true
      },
      "minecraft:follow_range": {
        "value": 1024
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:flying_speed": {
        "value": 0.3
      },
      "minecraft:navigation.hover": {
        "can_path_over_water": true,
        "can_sink": false,
        "can_pass_doors": false,
        "can_path_from_air": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "avoid_sun": false
      },
      "minecraft:movement.hover": {},
      "minecraft:jump.static": {},
      "minecraft:can_fly": {},
      "minecraft:health": {
        "value": 500,
        "max": 500
      },
      "minecraft:nameable": {},
      "minecraft:physics": {
        "has_collision": false,
        "has_gravity": false
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "awaking_moonlord:hostile_state",
            "awaking_moonlord:search_nearby_player"
          ]
        }
      },
      "awaking_moonlord:start_search_nearby_player": {
        "add": {
          "component_groups": [
            "awaking_moonlord:search_nearby_player"
          ]
        }
      },
      "awaking_moonlord:end_search_nearby_player": {
        "remove": {
          "component_groups": [
            "awaking_moonlord:search_nearby_player"
          ]
        },
        "trigger": "awaking_moonlord:start_dash"
      },
      "awaking_moonlord:start_dash": {
        "add": {
          "component_groups": [
            "awaking_moonlord:dashing_state"
          ]
        }
      },
      "awaking_moonlord:end_dash": {
        "remove": {
          "component_groups": [
            "awaking_moonlord:dashing_state"
          ]
        },
        "trigger": "awaking_moonlord:start_move_away"
      },
      "awaking_moonlord:start_move_away": {
        "add": {
          "component_groups": [
            "awaking_moonlord:moving_away_state"
          ]
        }
      },
      "awaking_moonlord:end_move_away": {
        "remove": {
          "component_groups": [
            "awaking_moonlord:moving_away_state"
          ]
        },
        "trigger": "awaking_moonlord:start_search_nearby_player"
      },
      "awaking_moonlord:no_moving": {
        "add": {
          "component_groups": [
            "awaking_moonlord:no_moving"
          ]
        }
      }
    }
  }
}