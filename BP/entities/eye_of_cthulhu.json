{
  "format_version": "1.26.0",
  "minecraft:entity": {
    "description": {
      "identifier": "awakening_moonlord:eye_of_cthulhu",
      "properties": {
        "eu:current_phase": {
          "client_sync": true,
          "default": 1,
          "range": [
            1,
            2
          ],
          "type": "int"
        },
        "eu:is_changing": {
          "client_sync": true,
          "default": false,
          "type": "bool"
        },
        "eu:is_dashing": {
          "client_sync": true,
          "default": false,
          "type": "bool"
        }
      },
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "awakening_moonlord:summoning_demon_eye": {},
      "awakening_moonlord:phase_1": {
        "minecraft:spawn_entity": {
          "entities": [
            {
              "min_wait_time": 30,
              "max_wait_time": 60,
              "spawn_entity": "awakening_moonlord:demon_eye",
              "single_use": false,
              "num_to_spawn": 4,
              "should_leash": false
            }
          ]
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": [
                {
                  "all_of": [
                    {
                      "test": "actor_health",
                      "operator": "<=",
                      "value": 512
                    }
                  ]
                }
              ],
              "event": "awakening_moonlord:start_changing_to_phase_2"
            }
          ]
        }
      },
      "awakening_moonlord:phase_2": {
        "minecraft:attack": {
          "damage": 4
        }
      },
      "awakening_moonlord:changing_to_phase_2": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:flying_speed": {
          "value": 0.0
        },
        "minecraft:timer": {
          "looping": true,
          "time": 3,
          "time_down_event": {
            "event": "awakening_moonlord:end_changing_to_phase_2"
          }
        }
      },
      "awakening_moonlord:no_moving": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:flying_speed": {
          "value": 0.0
        }
      },
      "awakening_moonlord:moving_away_phase_1_state": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:flying_speed": {
          "value": 0.0
        },
        "minecraft:timer": {
          "looping": true,
          "time": 1.5,
          "time_down_event": {
            "event": "awakening_moonlord:end_move_away_phase_1"
          }
        }
      },
      "awakening_moonlord:moving_away_phase_2_state": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:flying_speed": {
          "value": 0.0
        },
        "minecraft:timer": {
          "looping": true,
          "time": 0.75,
          "time_down_event": {
            "event": "awakening_moonlord:end_move_away_phase_2"
          }
        }
      },
      "awakening_moonlord:dashing_phase_1_state": {
        "minecraft:timer": {
          "looping": true,
          "time": 1.5,
          "time_down_event": {
            "event": "awakening_moonlord:end_dash_phase_1"
          }
        }
      },
      "awakening_moonlord:dashing_phase_2_state": {
        "minecraft:timer": {
          "looping": true,
          "time": 3.0,
          "time_down_event": {
            "event": "awakening_moonlord:end_dash_phase_2"
          }
        }
      },
      "awakening_moonlord:search_nearby_player_phase_1": {
        "minecraft:movement": {
          "value": 0.35
        },
        "minecraft:flying_speed": {
          "value": 0.35
        },
        "minecraft:target_nearby_sensor": {
          "inside_range": 7.0,
          "outside_range": 10.0,
          "must_see": true,
          "on_inside_range": {
            "event": "awakening_moonlord:end_search_nearby_player_phase_1",
            "target": "self"
          }
        }
      },
      "awakening_moonlord:search_nearby_player_phase_2": {
        "minecraft:movement": {
          "value": 0.4
        },
        "minecraft:flying_speed": {
          "value": 0.4
        },
        "minecraft:target_nearby_sensor": {
          "inside_range": 5.0,
          "outside_range": 10.0,
          "must_see": true,
          "on_inside_range": {
            "event": "awakening_moonlord:end_search_nearby_player_phase_2",
            "target": "self"
          }
        }
      },
      "awakening_moonlord:hostile_state": {
        "minecraft:behavior.hurt_by_target": {
          "priority": 1
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 64
            }
          ]
        },
        "minecraft:attack": {
          "damage": 3
        },
        "minecraft:behavior.melee_box_attack": {
          "priority": 2,
          "attack_once": false,
          "track_target": false,
          "speed_multiplier": 1.4
        }
      }
    },
    "components": {
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(10,20) : 0"
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:behavior.random_hover": {
        "priority": 12,
        "xz_dist": 8,
        "y_dist": 8,
        "y_offset": 4, //-1
        "interval": 1,
        "hover_height": [
          5,
          10
        ]
      },
      "minecraft:boss": {
        "hud_range": 55,
        "name": "Eye of Cthulhu"
      },
      "minecraft:leashable": {},
      "minecraft:balloonable": {
        "mass": 0.5
      },
      "minecraft:behavior.float": {
        "priority": 19
      },
      "minecraft:type_family": {
        "family": [
          "awakening_moonlord",
          "terra_boss",
          "eye_of_cthulhu",
          "mob",
          "arthropod"
        ]
      },
      "minecraft:breathable": {
        "totalSupply": 0,
        "suffocateTime": -1
      },
      "minecraft:collision_box": {
        "width": 2.5,
        "height": 2.5
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:game_event_movement_tracking": {
        "emit_flap": true
      },
      "minecraft:follow_range": {
        "value": 1024
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:flying_speed": {
        "value": 0.35
      },
      "minecraft:navigation.hover": {
        "can_path_over_water": true,
        "can_sink": false,
        "can_pass_doors": false,
        "can_path_from_air": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "avoid_sun": false
      },
      "minecraft:movement.hover": {},
      "minecraft:jump.static": {},
      "minecraft:can_fly": {},
      "minecraft:health": {
        "value": 1024,
        "max": 1024
      },
      "minecraft:nameable": {},
      "minecraft:physics": {
        "has_collision": false,
        "has_gravity": false
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "awakening_moonlord:hostile_state",
            "awakening_moonlord:phase_1",
            "awakening_moonlord:search_nearby_player_phase_1"
          ]
        }
      },
      "awakening_moonlord:start_search_nearby_player_phase_1": {
        "add": {
          "component_groups": [
            "awakening_moonlord:search_nearby_player_phase_1"
          ]
        }
      },
      "awakening_moonlord:start_search_nearby_player_phase_2": {
        "add": {
          "component_groups": [
            "awakening_moonlord:search_nearby_player_phase_2"
          ]
        }
      },
      "awakening_moonlord:end_search_nearby_player_phase_1": {
        "remove": {
          "component_groups": [
            "awakening_moonlord:search_nearby_player_phase_1"
          ]
        },
        "trigger": "awakening_moonlord:start_dash_phase_1"
      },
      "awakening_moonlord:end_search_nearby_player_phase_2": {
        "remove": {
          "component_groups": [
            "awakening_moonlord:search_nearby_player_phase_2"
          ]
        },
        "trigger": "awakening_moonlord:start_dash_phase_2"
      },
      "awakening_moonlord:start_dash_phase_1": {
        "add": {
          "component_groups": [
            "awakening_moonlord:dashing_phase_1_state"
          ]
        }
      },
      "awakening_moonlord:start_dash_phase_2": {
        "add": {
          "component_groups": [
            "awakening_moonlord:dashing_phase_2_state"
          ]
        },
        "set_property": {
          "eu:is_dashing": true
        }
      },
      "awakening_moonlord:end_dash_phase_1": {
        "remove": {
          "component_groups": [
            "awakening_moonlord:dashing_phase_1_state"
          ]
        },
        "trigger": "awakening_moonlord:start_move_away_phase_1"
      },
      "awakening_moonlord:end_dash_phase_2": {
        "remove": {
          "component_groups": [
            "awakening_moonlord:dashing_phase_2_state"
          ]
        },
        "set_property": {
          "eu:is_dashing": false
        },
        "trigger": "awakening_moonlord:start_move_away_phase_2"
      },
      "awakening_moonlord:start_move_away_phase_1": {
        "add": {
          "component_groups": [
            "awakening_moonlord:moving_away_phase_1_state"
          ]
        }
      },
      "awakening_moonlord:start_move_away_phase_2": {
        "add": {
          "component_groups": [
            "awakening_moonlord:moving_away_phase_2_state"
          ]
        }
      },
      "awakening_moonlord:end_move_away_phase_1": {
        "remove": {
          "component_groups": [
            "awakening_moonlord:moving_away_phase_1_state"
          ]
        },
        "trigger": "awakening_moonlord:start_search_nearby_player_phase_1"
      },
      "awakening_moonlord:end_move_away_phase_2": {
        "remove": {
          "component_groups": [
            "awakening_moonlord:moving_away_phase_2_state"
          ]
        },
        "trigger": "awakening_moonlord:start_search_nearby_player_phase_2"
      },
      "awakening_moonlord:no_moving": {
        "add": {
          "component_groups": [
            "awakening_moonlord:no_moving"
          ]
        }
      },
      "awakening_moonlord:start_changing_to_phase_2": {
        "add": {
          "component_groups": [
            "awakening_moonlord:changing_to_phase_2"
          ]
        },
        "remove": {
          "component_groups": [
            "awakening_moonlord:search_nearby_player_phase_1",
            "awakening_moonlord:phase_1"
          ]
        },
        "set_property": {
          "eu:is_changing": true
        }
      },
      "awakening_moonlord:end_changing_to_phase_2": {
        "add": {
          "component_groups": [
            "awakening_moonlord:phase_2",
            "awakening_moonlord:search_nearby_player_phase_2"
          ]
        },
        "remove": {
          "component_groups": [
            "awakening_moonlord:changing_to_phase_2"
          ]
        },
        "set_property": {
          "eu:current_phase": 2,
          "eu:is_changing": false
        }
      }
    }
  }
}